{
  "name": "bill-control",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --grep-invert '@a11y|@visual'",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:deployed": "playwright test --config playwright.deployed.config.ts",
    "generate:fallbacks": "npm run build && node scripts/generate-fallbacks.mjs",
    "generate:links": "node scripts/generate-link-artifacts.mjs",
    "validate:release-artifacts": "node scripts/validate-release-artifacts.mjs",
    "validate:interactions": "node scripts/validate-interactions.mjs",
    "audit:final": "node scripts/final-canonical-audit.mjs",
    "validate:fixtures": "tsx lib/fixture-validation.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run validate:fixtures && npm run validate:interactions && npm run test && npm run build",
    "verify:pre-release": "npm run check && npm run test:e2e && npm run test:a11y && npm run test:visual",
    "verify:release": "npm run verify:pre-release && npm run generate:fallbacks && npm run validate:release-artifacts && if [ -n \"$BASE_URL\" ]; then npm run test:deployed; else echo 'BASE_URL not set; deployed smoke test skipped'; fi",
    "verify:final": "npm audit --audit-level=low && npm run audit:final && npm run verify:release && npm run build:sites"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.23",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "qrcode": "^1.5.4",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vinext": "^0.0.50",
    "vite": "^8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
